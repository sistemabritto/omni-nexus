{
  "active_provider": "omnirouter",
  "providers": {
    "omnirouter": {
      "name": "OpenClaude (via OmniRoute)",
      "description": "OpenAI-compatible custom provider (URL, API Key e Model).",
      "cli_command": "openclaude",
      "env_vars": {
        "CLAUDE_CODE_USE_OPENAI": "1",
        "OPENAI_BASE_URL": "http://omniroute:20128/v1",
        "OPENAI_API_KEY": "sk-761...3957",
        "OPENAI_MODEL": "auto/best-coding"
      },
      "default_base_url": "http://omniroute:20128/v1",
      "default_model": "nvidia/meta/llama-3.1-70b-instruct",
      "model_chain": [
        "nvidia/meta/llama-3.1-70b-instruct",
        "auto/reasoning",
        "auto/coding",
        "auto/fast",
        "auto/best-chat",
        "auto/cheap",
        "auto/coding:cheap",
        "auto/reasoning:pro"
      ],
      "fallback_providers": [
        "nvidia",
        "openrouter",
        "anthropic",
        "opencode-go"
      ],
      "requires_logout": true
    },
    "nvidia": {
      "name": "NVIDIA NIM",
      "description": "Modelos hospedados na NVIDIA NIM (quota gratuita, rotaciona automaticamente).",
      "cli_command": "openclaude",
      "env_vars": {
        "CLAUDE_CODE_USE_OPENAI": "1",
        "OPENAI_BASE_URL": "https://integrate.api.nvidia.com/v1",
        "NVIDIA_API_KEY": "",
        "OPENAI_MODEL": ""
      },
      "default_base_url": "https://integrate.api.nvidia.com/v1",
      "default_model": "",
      "model_chain": [
        "stepfun-ai/step-3.7-flash",
        "nvidia/nemotron-3-ultra-550b-a55b",
        "nvidia/nemotron-3-super-120b-a12b",
        "qwen/qwen3.5-397b-a17b",
        "openai/gpt-oss-120b",
        "microsoft/phi-4-multimodal-instruct",
        "stepfun-ai/step-3.5-flash"
      ],
      "fallback_providers": [
        "openrouter",
        "anthropic"
      ],
      "requires_logout": true
    },
    "openrouter": {
      "name": "OpenRouter (Free Tier)",
      "description": "200+ modelos via OpenRouter - APENAS FREE para não gastar crédito.",
      "cli_command": "openclaude",
      "env_vars": {
        "CLAUDE_CODE_USE_OPENAI": "1",
        "OPENAI_BASE_URL": "https://openrouter.ai/api/v1",
        "OPENAI_API_KEY": "sk-or-...de1c",
        "OPENAI_MODEL": "openrouter/owl-alpha"
      },
      "default_base_url": "https://openrouter.ai/api/v1",
      "default_model": "openrouter/owl-alpha",
      "model_chain": [
        "openrouter/qwen/qwen3.7-max-preview",
        "openrouter/meta-llama/llama-3.3-70b-instruct:free",
        "nex-agi/nex-n2-pro:free",
        "openrouter/owl-alpha"
      ],
      "fallback_providers": [
        "anthropic"
      ],
      "requires_logout": true,
      "mode": "code"
    },
    "anthropic": {
      "name": "Anthropic (Claude nativo - PAGO)",
      "description": "Claude Code oficial via Anthropic API - USAR SÓ PARA HEAVY TASKS.",
      "cli_command": "claude",
      "env_vars": {},
      "requires_logout": false
    },
    "opencode-go": {
      "name": "OpenCode Go (Quota Baixa - Último Recurso)",
      "description": "OpenCode Go com modelos variados mas quota baixa - só quando precisar.",
      "cli_command": "opencode",
      "env_vars": {
        "OPENAI_BASE_URL": "http://127.0.0.1:20129/v1",
        "OPENAI_API_KEY": "sk-...",
        "OPENAI_MODEL": "kimi-k3"
      },
      "model_chain": [
        "opencode-go/kimi-k3",
        "opencode-go/minimax-m3",
        "opencode-go/deepseek-v4-flash",
        "opencode-go/deepseek-v4-pro"
      ],
      "fallback_providers": [],
      "requires_logout": true
    }
  }
}