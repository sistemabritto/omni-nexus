<clickhouse>
  <logger>
    <level>warning</level>
    <size>20M</size>
    <count>3</count>
  </logger>
  <text_log>
    <level>warning</level>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    <flush_interval_milliseconds>30000</flush_interval_milliseconds>
  </text_log>
  <query_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    <flush_interval_milliseconds>30000</flush_interval_milliseconds>
  </query_log>
  <!-- Unused internal profiling streams were generating continuous disk I/O. -->
  <trace_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <part_log remove="1"/>
  <background_schedule_pool_log remove="1"/>
  <processors_profile_log remove="1"/>
</clickhouse>
