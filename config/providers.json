    "omnirouter": {
      "name": "OpenClaude (via OmniRoute)",
      "description": "OpenAI-compatible custom provider (URL, API Key e Model).",
      "cli_command": "openclaude",
      "env_vars": {
        "CLAUDE_CODE_USE_OPENAI": "1",
        "OPENAI_BASE_URL": "http://omniroute:20128/v1",
        "OPENAI_API_KEY": "sk-761...3957",
        "OPENAI_MODEL": "claude/claude-sonnet-5"
      },
      "default_base_url": "http://omniroute:20128/v1",
      "default_model": "claude/claude-sonnet-5",
      "model_chain": [
        "claude/claude-sonnet-5",
        "claude/claude-haiku-4-5-20251001",
        "claude/claude-opus-5",
        "nvidia/meta/llama-3.1-70b-instruct",
        "auto/reasoning",
        "auto/coding",
        "auto/fast",
        "auto/best-chat",
        "auto/cheap"
      ],
      "fallback_providers": [
        "openrouter",
        "anthropic",
        "opencode-go"
      ],
      "requires_logout": true,
      "mode": "code"
    },
    "nvidia": {
