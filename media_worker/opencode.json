{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "models": {
        "auto": {
          "name": "OpenCode auto (LKGP)"
        }
      },
      "name": "OpenCode",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "{env:OPENAI_BASE_URL}"
      }
    }
  },
  "agent": {
    "build": {
      "steps": 20,
      "tools": {
        "skill": true
      }
    }
  }
}
