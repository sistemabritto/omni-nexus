{{!-- Navegação. Sticky com blur; a borda só aparece depois que a página rola,
      sinal sutil de que o conteúdo passou por baixo. --}}
<header class="nav" data-nav>
    <div class="container nav__interno">
        <a class="nav__marca" href="{{@site.url}}" aria-label="{{@site.title}}, início">
            {{#if @site.logo}}
                <img src="{{@site.logo}}" alt="{{@site.title}}" width="120" height="30">
            {{else}}
                <span class="nav__marca-selo" aria-hidden="true">SB</span>
                <span>{{@site.title}}</span>
            {{/if}}
        </a>

        {{!-- Um botão só, e ele faz a única coisa que importa aqui: levar
              quem está lendo o blog para o site.

              Os itens de navegação do Ghost saíram do cabeçalho. "News" leva
              para a página em que a pessoa já está, e "Site" duplicava este
              botão — duas escolhas para um destino só. Continuam disponíveis
              no rodapé, para quem procura. --}}
        <a class="nav__ir-site" href="https://sistemabritto.com.br?utm_source=blog&utm_medium=content&utm_campaign=menu">
            {{!-- Dois rótulos, não um cortado. Truncar com reticências
                  ("Conhecer o Sist…") ocupa o mesmo espaço e deixa de
                  informar o destino, que é a única função do botão. --}}
            <span class="nav__ir-site-longo">Conhecer o Sistema Britto</span>
            <span class="nav__ir-site-curto">Ir ao site</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h13M12 5l7 7-7 7"/>
            </svg>
        </a>

    </div>
</header>
