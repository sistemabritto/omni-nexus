{{!< default}}
{{#author}}
<section class="perfil">
    <div class="container">
        {{#if profile_image}}<img src="{{profile_image}}" alt="{{name}}" width="96" height="96">{{/if}}
        <h1 style="font-size:var(--t-2xl)">{{name}}</h1>
        {{#if bio}}<p style="max-width:52ch;margin:0 auto;color:var(--texto-suave)">{{bio}}</p>{{/if}}
        <p style="color:var(--texto-fraco);font-size:var(--t-sm);margin-top:1rem">
            {{plural ../pagination.total empty="Nenhum artigo ainda" singular="% artigo publicado" plural="% artigos publicados"}}
        </p>
    </div>
</section>
{{/author}}

{{!-- Mesma correção de tag.hbs: o helper {{pagination}} precisa do contexto
      raiz da rota, não do de dentro de {{#author}}. --}}
<section class="secao">
    <div class="container">
        <div class="bento">
            {{#foreach posts}}{{> post-card}}{{/foreach}}
        </div>
        {{pagination}}
    </div>
</section>
